#!/usr/bin/expect -f

if {$argc < 4 || $argc > 5} { puts stderr "usage: viewer-pty.exp ROOT TMP REAL_FZF REAL_LESS ?top|bottom?"; exit 2 }
set root [lindex $argv 0]
set tmp [lindex $argv 1]
set real_fzf [lindex $argv 2]
set real_less [lindex $argv 3]
set picker_layout bottom
if {$argc == 5} { set picker_layout [lindex $argv 4] }
if {$picker_layout ni {top bottom}} { puts stderr "invalid picker layout"; exit 2 }
set state [file join $tmp "pty-state-abcdefghijklmnopqrstuvwxyz-abcdefghijklmnopqrstuvwxyz-abcdefghijklmnopqrstuvwxyz-abcdefghijklmnop"]
set config [file join $tmp pty-config]
set bin [file join $tmp pty-bin]
set counts [file join $tmp pty-counts]
set source [file join $tmp pty-source]
set action_failure [file join $tmp action-failure]
file mkdir $state $config $bin $counts $source
exec chmod 700 $state $config $bin $counts
foreach utility {open pbcopy xdg-open wl-copy xclip xsel} {
  set u [open [file join $bin $utility] w]
  puts $u {#!/bin/sh
cat >/dev/null
[ -e "$PTY_ACTION_FAILURE" ] && exit 1
exit 0}
  close $u
  exec chmod 700 [file join $bin $utility]
}
set shell_wrapper [open [file join $bin sh] w]
puts $shell_wrapper {#!/bin/sh
case " $* " in *viewer-preview.sh*) printf '%s\n' "$*" >> "$PTY_PREVIEW_LOG" ;; esac
exec /bin/sh "$@"}
close $shell_wrapper
exec chmod 700 [file join $bin sh]
if {[string length [file normalize $state]] <= 104} { puts stderr "long state path is not long enough"; exit 1 }

set f [open [file join $config config.sh] w]
puts $f {JIRA_BASE="https://jira.example.test"}
puts $f {JIRA_SITE="jira-example"}
puts $f {JIRA_PROJECTS="ABC"}
puts $f {CACHE_TTL_MIN=10}
puts $f {MAX_CANDIDATES=20}
puts $f "PICKER_LAYOUT='$picker_layout'"
close $f
set f [open [file join $source visible] w]; puts $f "ABC-1 DEF-2 ABC-3"; close $f
set f [open [file join $source recent-unwrapped] w]; puts $f "ABC-1"; close $f
set f [open [file join $state candidates] w]
for {set i 1} {$i <= 11} {incr i} { puts $f "ABC-$i" }
close $f

set f [open [file join $bin fzf] w]
puts $f {#!/bin/sh
exec "$PTY_REAL_FZF" "$@" --bind 'alt-q:execute-silent(printf %s {q} > "$PTY_QUERY_CAPTURE.pending" && mv "$PTY_QUERY_CAPTURE.pending" "$PTY_QUERY_CAPTURE")'
}
close $f
exec chmod 700 [file join $bin fzf]
file link -symbolic [file join $bin less] $real_less
set h [open [file join $bin herdr] w]
puts $h {#!/bin/sh
printf "%s\n" "$*" >> "$PTY_HERDR_LOG"
if [ "$1" = pane ] && [ "$2" = get ]; then printf '%s\n' '{"result":{"pane":{"pane_id":"source-pane","terminal_id":"source-terminal"}}}'; exit 0; fi
if [ "$1" = pane ] && [ "$2" = read ]; then
  if [ -e "$PTY_SOURCE/scan-gate" ]; then
    : > "$PTY_SOURCE/scan-started"
    while [ ! -f "$PTY_SOURCE/scan-release" ]; do sleep 0.02; done
  fi
  cat "$PTY_SOURCE/${5:-visible}"; exit 0
fi
exit 1}
close $h
exec chmod 700 [file join $bin herdr]
set t [open [file join $bin twg] w]
puts $t {#!/bin/sh
case " $* " in *' whoami '*) printf '%s\n' '{"accountId":"fictional-user"}'; exit 0 ;; esac
printf "%s\n" "$*" >> "$PTY_METADATA_LOG"
case " $* " in
  *" --comments "*) : ;;
  *" --fields "*)
  if ! mkdir "$PTY_COUNTS/.metadata-lock" 2>/dev/null; then : > "$PTY_METADATA_OVERLAP"; printf '%s\n' 'overlapping metadata batch' >&2; exit 97; fi
  trap 'rmdir "$PTY_COUNTS/.metadata-lock"' 0 1 2 15
  if [ -n "${PTY_METADATA_GATE:-}" ] && [ ! -f "$PTY_METADATA_RELEASE" ]; then
    : > "$PTY_METADATA_STARTED"
    while [ ! -f "$PTY_METADATA_RELEASE" ]; do sleep 0.05; done
  fi
  jq -n '{data:{items:[range(1;17) | {input:("ABC-"+tostring),ok:true,data:{key:("ABC-"+tostring),summary:("PTY issue "+tostring),status:{name:"Done"}}}]}}'
  exit 0
  ;;
esac
key=
for arg in "$@"; do
  case "$arg" in ABC-[0-9]*) key=$arg;; esac
done
[ -n "$key" ] || key=ABC-1
count_file="$PTY_COUNTS/$key"
count=0
[ -f "$count_file" ] && count=$(cat "$count_file")
count=$((count + 1))
printf "%s\n" "$count" > "$count_file"
body="PTY body $key version $count"
i=1
while [ "$key" != ABC-17 ] && [ "$i" -le 60 ]; do body="$body
Preview line $i"; i=$((i + 1)); done
paragraph=
i=1
while [ "$i" -le 120 ]; do paragraph="$paragraph REFLOW-WORD-$i"; i=$((i + 1)); done
body="$body
REFLOW-BEGIN$paragraph REFLOW-END"
jq -n --arg key "$key" --arg body "$body" '{key:$key,summary:$key,description:$body,status:{name:"Done"}}'
}
close $t
exec chmod 700 [file join $bin twg]

set env(PATH) "$bin:$env(PATH)"
set env(HERDR_SOCKET_PATH) ""
set env(TWG_BIN_PATH) [file join $bin twg]
set env(HERDR_PLUGIN_CONFIG_DIR) $config
set env(HERDR_PLUGIN_STATE_DIR) $state
set env(PTY_COUNTS) $counts
set env(PTY_SOURCE) $source
set env(PTY_PREVIEW_LOG) [file join $tmp preview.log]
set env(PTY_REAL_FZF) $real_fzf
set env(PTY_QUERY_CAPTURE) [file join $tmp captured-query]
set env(PTY_HERDR_LOG) [file join $tmp herdr.log]
set env(HERDR_BIN_PATH) [file join $bin herdr]
set env(HERDR_VIEWER_SOURCE_PANE) source-pane
set env(HERDR_VIEWER_SOURCE_TERMINAL) source-terminal
set env(HERDR_VIEWER_CANDIDATES) [join {ABC-1 ABC-2 ABC-3 ABC-4 ABC-5 ABC-6 ABC-7 ABC-8 ABC-9 ABC-10 ABC-11} "\n"]
set env(PTY_METADATA_OVERLAP) [file join $tmp metadata-overlap]
set env(PTY_METADATA_LOG) [file join $tmp metadata.log]
set env(PTY_ACTION_FAILURE) $action_failure
set env(TERM) xterm-256color
set env(COLUMNS) 100
set env(LINES) 40
set env(NO_COLOR) 1
set timeout 15
match_max 20000
log_user 0
set observed_output {}
log_file -a [file join $tmp pty-transcript]
set stty_init {rows 40 columns 100}

proc stop_child {} {
  global spawn_id
  # Each spawned PTY owns a process group. Stop its fake CLIs too, including
  # deliberately gated workers, so a failed assertion cannot hang the suite.
  catch {exec kill -TERM -- -[exp_pid -i $spawn_id]}
  catch {exec kill -KILL -- -[exp_pid -i $spawn_id]}
  catch {close -i $spawn_id}
  catch {wait -i $spawn_id}
}
proc slurp {path} {
  set channel [open $path r]
  set contents [read $channel]
  close $channel
  return $contents
}
proc observe {value} {
  global observed_output
  append observed_output $value
  if {[string length $observed_output] > 200000} { set observed_output [string range $observed_output end-199999 end] }
}
proc send_key {key} {
  global observed_output spawn_id
  set observed_output {}
  send -i $spawn_id -- $key
}
proc await_help_state {desired phase} {
  global state spawn_id
  set timeout 0
  set last_output_ms [clock milliseconds]
  for {set i 0} {$i < 100} {incr i} {
    expect {
      -re {(?s).*?\033\[6n} { observe $expect_out(buffer); set last_output_ms [clock milliseconds]; send -i $spawn_id "\033\[1;1R"; exp_continue }
      -re {(?s).+} { observe $expect_out(buffer); set last_output_ms [clock milliseconds]; exp_continue }
      eof { puts stderr "PTY EOF: $phase while polling help state"; stop_child; exit 1 }
      timeout {}
    }
    set dirs [glob -nocomplain -directory $state .viewer.*]
    if {$dirs ne ""} {
      set path [file join [lindex $dirs 0] ui-help]
      set present [file exists $path]
      if {$present == $desired && [clock milliseconds] - $last_output_ms >= 100} { return }
    }
    after 20
  }
  puts stderr "PTY timeout: $phase help state desired=$desired"
  stop_child
  exit 1
}
proc await_layout {expected phase} {
  global state spawn_id spawn_out observed_output timeout
  set previous_timeout $timeout
  set timeout 0
  set deadline [expr {[clock milliseconds] + 5000}]
  set path [file join [lindex [glob -nocomplain -directory $state .viewer.*] 0] ui-layout]
  while {[clock milliseconds] < $deadline} {
    # Keep draining the PTY while the fzf background resize transform runs.
    # If the master stops reading, fzf can block flushing the new screen and
    # never process the resize event we are waiting for.
    expect {
      -re {(?s).*?\033\[6n} { observe $expect_out(buffer); send -i $spawn_id "\033\[1;1R" }
      -re {(?s).+} { observe $expect_out(buffer) }
      eof { break }
      timeout {}
    }
    if {[file exists $path] && [string match $expected [string trim [slurp $path]]]} { set timeout $previous_timeout; return }
    after 20
  }
  set actual_layout unknown
  if {[file exists $path]} { set actual_layout [string trim [slurp $path]] }
  set terminal_size unknown
  catch { set terminal_size [string trim [exec stty size < $spawn_out(slave,name)]] }
  puts stderr "PTY timeout: $phase layout expected=$expected actual=$actual_layout stty_size=$terminal_size"
  set timeout $previous_timeout
  stop_child
  exit 1
}
proc await_selected_key {key} {
  global spawn_id state
  set timeout 0
  set deadline [expr {[clock milliseconds] + 10000}]
  while {[clock milliseconds] < $deadline} {
    expect {
      -re "\033\\\[6n" { observe $expect_out(buffer); send -i $spawn_id "\033\[1;1R" }
      -re {(?s).+} { observe $expect_out(buffer) }
      eof { puts stderr "PTY EOF: selection burst"; stop_child; exit 1 }
      timeout {}
    }
    set key_file [file join $state sources source-source-terminal key]
    if {[file exists $key_file] && [string trim [slurp $key_file]] eq $key} { return }
    after 5
  }
  set selected_path [file join $state sources source-source-terminal key]
  set selected_value [expr {[file exists $selected_path] ? [string trim [slurp $selected_path]] : "(missing)"}]
  puts stderr "PTY timeout: selection burst desired=$key actual=$selected_value"; stop_child; exit 1
}
proc capture_query {phase} {
  global spawn_id tmp
  set path [file join $tmp captured-query]
  file delete -force $path
  send -i $spawn_id "\033q"
  set timeout 0
  set deadline [expr {[clock milliseconds] + 5000}]
  while {[clock milliseconds] < $deadline} {
    expect {
      -re {(?s).*?\033\[6n} { observe $expect_out(buffer); send -i $spawn_id "\033\[1;1R" }
      -re {(?s).+} { observe $expect_out(buffer) }
      eof { puts stderr "PTY EOF: $phase query capture"; stop_child; exit 1 }
      timeout {}
    }
    if {[file exists $path]} { return [slurp $path] }
    after 5
  }
  puts stderr "PTY timeout: $phase query capture"
  stop_child
  exit 1
}
proc await_feedback_clear {phase} {
  global spawn_id state
  set timeout 0
  set deadline [expr {[clock milliseconds] + 9000}]
  while {[clock milliseconds] < $deadline} {
    expect {
      -re "\033\\\[6n" { observe $expect_out(buffer); send -i $spawn_id "\033\[1;1R" }
      -re {(?s).+} { observe $expect_out(buffer) }
      eof { puts stderr "PTY EOF: $phase feedback expiry"; stop_child; exit 1 }
      timeout {}
    }
    set dirs [glob -nocomplain -directory $state .viewer.*]
    if {$dirs ne "" && ![file exists [file join [lindex $dirs 0] ui-message]]} {
      settle_output "$phase feedback expiry"
      return
    }
    after 25
  }
  puts stderr "PTY timeout: $phase feedback did not expire"; stop_child; exit 1
}
proc await {phase pattern} {
  global spawn_id state tmp observed_output spawn_out timeout
  if {[regexp $pattern $observed_output]} { return }
  set previous_timeout $timeout
  set timeout 0
  set deadline [expr {[clock milliseconds] + 15000}]
  set saw_eof 0
  while {[clock milliseconds] < $deadline && !$saw_eof} {
    expect {
      -re {(?s).*?\033\[6n} { observe $expect_out(buffer); send -i $spawn_id "\033\[1;1R" }
      -re {(?s).+} { observe $expect_out(buffer) }
      eof { if {[info exists expect_out(buffer)]} { observe $expect_out(buffer) }; set saw_eof 1 }
      timeout {}
    }
    if {[regexp $pattern $observed_output]} { set timeout $previous_timeout; return }
    after 5
  }
  set timeout $previous_timeout
  set dirs [glob -nocomplain -directory $state .viewer.*]
  set diag_state $state
  if {$dirs ne ""} { set diag_state [lindex $dirs 0] }
  catch {
    set out [open [file join $tmp pty-failure-candidates] w]
    if {[file exists [file join $diag_state candidates]]} { puts -nonewline $out [slurp [file join $diag_state candidates]] }
    close $out
    set out [open [file join $tmp pty-failure-status] w]
    if {[file exists [file join $diag_state status]]} { puts -nonewline $out [slurp [file join $diag_state status]] }
    close $out
    if {$dirs ne ""} {
      set err [file join $diag_state fzf-stderr]
      if {[file exists $err]} { file copy -force $err [file join $tmp pty-failure-stderr] }
    }
  }
  set preview_lines [regexp -all -inline {Preview line [0-9]+} $observed_output]
  set preview_positions [regexp -all -inline {[0-9]+/[0-9]+} $observed_output]
  set rows [glob -nocomplain -directory [file join $diag_state rows] *]
  set layout [expr {[file exists [file join $diag_state ui-layout]] ? [slurp [file join $diag_state ui-layout]] : "(missing)"}]
  puts stderr "PTY diagnostic detail $phase: preview_lines=$preview_lines preview_positions=$preview_positions rows=[llength $rows] pending_snapshot=[file exists [file join $diag_state pending-snapshot]] ui_layout=$layout"
  set terminal_size unknown
  catch { set terminal_size [string trim [exec stty size < $spawn_out(slave,name)]] }
  set terminal_groups unknown
  catch { set terminal_groups [string trim [exec ps -o pid=,pgid=,tpgid= -p [exp_pid -i $spawn_id]]] }
  puts stderr "PTY diagnostic $phase: terminal_size=$terminal_size process_groups=$terminal_groups saw_eof=$saw_eof"
  set sample [string map [list "\033" "<ESC>" "\r" "<CR>" "\n" "<LF>"] $observed_output]
  set start [expr {[string length $sample] > 240 ? [string length $sample] - 240 : 0}]
  puts stderr "PTY [expr {$saw_eof ? "EOF" : "timeout"}]: $phase [string range $sample $start end]"
  stop_child
  exit 1
}
proc await_initial_preview {} {
  global spawn_id observed_output
  set body_seen [regexp {PTY body ABC-1 version 1} $observed_output]
  set full_preview_seen [regexp {1/[0-9]+} $observed_output]
  if {$body_seen && $full_preview_seen} { return }
  expect {
    -re "PTY body ABC-1 version 1" { observe $expect_out(buffer); set body_seen 1; if {$full_preview_seen} { return }; exp_continue }
    -re {1/[0-9]+} { observe $expect_out(buffer); set full_preview_seen 1; if {$body_seen} { return }; exp_continue }
    -re "\033\\\[6n" { observe $expect_out(buffer); send -i $spawn_id "\033\[1;1R"; exp_continue }
    eof { puts stderr "PTY EOF: initial preview"; stop_child; exit 1 }
    timeout { puts stderr "PTY timeout: initial preview"; stop_child; exit 1 }
  }
}
proc settle_output {phase} {
  global spawn_id state counts
  set timeout 0
  set last_activity [clock milliseconds]
  set deadline [expr {[clock milliseconds] + 5000}]
  while {[clock milliseconds] < $deadline} {
    expect {
      -re {(?s).*?\033\[6n} { observe $expect_out(buffer); send -i $spawn_id "\033\[1;1R"; set last_activity [clock milliseconds] }
      -re {(?s).+} { observe $expect_out(buffer); set last_activity [clock milliseconds] }
      eof { puts stderr "PTY EOF: $phase while settling"; stop_child; exit 1 }
      timeout {}
    }
    set viewer_dirs [glob -nocomplain -directory $state .viewer.*]
    set pending_refresh {}
    if {$viewer_dirs ne ""} {
      set pending_refresh [glob -nocomplain -directory [file join [lindex $viewer_dirs 0] pending-refresh] *]
      foreach request [glob -nocomplain -directory [lindex $viewer_dirs 0] .request.*] { lappend pending_refresh $request }
    }
    set metadata_idle 1
    if {[file exists [file join $counts .metadata-lock]]} { set metadata_idle 0 }
    if {$viewer_dirs ne "" && [file exists [file join [lindex $viewer_dirs 0] pending-snapshot]]} { set metadata_idle 0 }
    if {[clock milliseconds] - $last_activity >= 250 && $metadata_idle && $pending_refresh eq ""} { return }
    after 20
  }
  puts stderr "PTY timeout: $phase output did not settle"; stop_child; exit 1
}

# A short issue used to print at the bottom of the screen. Require the real
# pager to move home before its heading, and remain open until q.
spawn -noecho sh "$root/scripts/viewer-reader.sh" "$root/scripts" ABC-17
await short-reader-top "\033\\\[HIssue details"
await short-reader-body {PTY body ABC-17 version 1}
await short-reader-help {q back · ↑↓ scroll · Space/b page}
send_key "q"
expect {
  eof {}
  timeout { puts stderr "PTY timeout: short reader close"; stop_child; exit 1 }
}
set reader_status [wait -i $spawn_id]
if {[lindex $reader_status 3] != 0} { puts stderr "short reader exited nonzero: $reader_status"; exit 1 }
set observed_output {}
puts "ok - short issue reader starts at the top and waits for q"

spawn -noecho sh "$root/scripts/viewer.sh"
await header {Filter >}
await_initial_preview
settle_output before-layout-navigation
if {$picker_layout eq "bottom"} { send_key "\033\[A" } else { send_key "\033\[B" }
await_selected_key ABC-2
await layout-older-issue {PTY body ABC-2 version 1}
if {$picker_layout eq "bottom"} { send_key "\033\[B" } else { send_key "\033\[A" }
await_selected_key ABC-1
await layout-newest-issue {PTY body ABC-1 version 1}
puts "ok - $picker_layout layout selects newest first and navigates in visual order"
settle_output before-preview-page-down
send_key "\033\[6~"
await preview-page-down {Preview line 40}
settle_output before-preview-page-up
send_key "\033\[5~"
await preview-page-up {PTY body ABC-1 version 1}
send_key "\033OP"
await help-open {PgUp/PgDn scroll}
await_help_state 1 initial-help-open
send_key "\033OP"
await help-closed {PTY body ABC-1 version 1}
set viewer_dir [lindex [glob -nocomplain -directory $state .viewer.*] 0]
await_help_state 0 initial-help-closed
# Keep a real query active while changing dimensions. A resize is only a
# layout change: the selected issue, its cached preview body, and fzf's query
# and scroll position must remain where the user left them.
send_key "'ABC-1"
await_selected_key ABC-1
settle_output before-query-resize
send_key "\033\[6~"
await query-resize-preview-scrolled {Preview line 40}
settle_output before-query-resize-scrolled
set count_file [file join $counts ABC-1]
set resize_fetch_count [string trim [slurp $count_file]]
set resize_preview_starts [llength [split [string trim [slurp $env(PTY_PREVIEW_LOG)]] "\n"]]
# Capture the actual fzf query through a test-only binding. A later keystroke
# can happen to select the same issue even if resize discarded the query.
set query_before_resize [capture_query query-before-resize]
if {$query_before_resize ne "'ABC-1"} {
  puts stderr "unexpected active query before resize: <$query_before_resize>"; stop_child; exit 1
}
# `send_key` cleared the PTY transcript before this PgDn, so this is a fresh
# viewport anchor. Requiring it after narrowing detects a reset-to-top.
set scroll_anchor {Preview line 40}
if {[string first $scroll_anchor $observed_output] < 0} {
  puts stderr "fresh pre-resize viewport did not contain $scroll_anchor"; stop_child; exit 1
}
set observed_output {}
exec stty rows 30 columns 55 < $spawn_out(slave,name)
await query-resize-rendered $scroll_anchor
settle_output query-resize-rendered
if {[string trim [slurp [file join $state sources source-source-terminal key]]] ne "ABC-1"} {
  puts stderr "resize changed the selected issue"; stop_child; exit 1
}
if {[string trim [slurp $count_file]] ne $resize_fetch_count} {
  puts stderr "resize fetched issue detail again"; stop_child; exit 1
}
if {[string first $scroll_anchor $observed_output] < 0} {
  puts stderr "resize lost the current preview viewport anchor $scroll_anchor"; stop_child; exit 1
}
# The long, single-paragraph fixture remains pageable after the narrow resize.
# Walk the real fzf preview until its unique tail marker becomes visible.
send_key [string repeat "\033\[6~" 15]
await narrow-preview-paragraph-tail {REFLOW-END}
settle_output narrow-preview-paragraph-tail
if {[string first REFLOW-END $observed_output] < 0} { puts stderr "narrow preview cannot reach paragraph tail"; stop_child; exit 1 }
if {[string trim [slurp $count_file]] ne $resize_fetch_count} {
  puts stderr "paging the narrow preview fetched issue detail again"; stop_child; exit 1
}
set narrow_preview_starts [llength [split [string trim [slurp $env(PTY_PREVIEW_LOG)]] "\n"]]
if {$narrow_preview_starts != $resize_preview_starts} {
  puts stderr "paging the narrow preview restarted its renderer"; stop_child; exit 1
}
# Check the query itself, then prove it still drives filtering after resize.
set query_after_resize [capture_query query-after-resize]
if {$query_after_resize ne $query_before_resize} {
  puts stderr "resize changed the active query: <$query_before_resize> -> <$query_after_resize>"; stop_child; exit 1
}
set observed_output {}
exec stty rows 40 columns 170 < $spawn_out(slave,name)
await query-resize-wide-paragraph {REFLOW-END}
settle_output query-resize-wide-paragraph
if {[string first REFLOW-END $observed_output] < 0} { puts stderr "wide resize lost the paragraph tail"; stop_child; exit 1 }
if {[string trim [slurp $count_file]] ne $resize_fetch_count} {
  puts stderr "resize reflow fetched issue detail again"; stop_child; exit 1
}
set current_preview_starts [llength [split [string trim [slurp $env(PTY_PREVIEW_LOG)]] "\n"]]
if {$current_preview_starts != $resize_preview_starts} {
  puts stderr "resize restarted the preview renderer ($resize_preview_starts -> $current_preview_starts)"; stop_child; exit 1
}
send_key "0"
await_selected_key ABC-10
set query_after_extension [capture_query query-after-extension]
if {$query_after_extension ne "'ABC-10"} {
  puts stderr "typing after resize did not extend the query: <$query_after_extension>"; stop_child; exit 1
}
exec stty rows 40 columns 100 < $spawn_out(slave,name)
settle_output query-resize-restored
send_key "\025"
settle_output query-resize-filter-cleared
puts "ok - active query, selection, cached preview, and scroll survive resize"
set sweep_fetch_count [string trim [slurp [file join $counts ABC-10]]]
foreach dimensions {{20 170} {10 55} {5 20} {2 5} {1 1} {40 55} {40 20} {40 5} {40 1}} {
  lassign $dimensions rows cols
  set observed_output {}
  exec stty rows $rows columns $cols < $spawn_out(slave,name)
  settle_output "resize-small-$rows-$cols"
  # Discard earlier paints: only output after growing proves recovery.
  set observed_output {}
  exec stty rows 40 columns 100 < $spawn_out(slave,name)
  await "resize-restored-$rows-$cols" {PTY body ABC-10 version 1}
  settle_output "resize-restored-$rows-$cols"
}
# A dragged divider produces a burst of resizes while callbacks are running.
set burst_preview_starts [llength [split [string trim [slurp $env(PTY_PREVIEW_LOG)]] "\n"]]
set burst_layout_direction [expr {$picker_layout eq "bottom" ? "up" : "down"}]
set observed_output {}
exec sh -c {
  i=0
  while [ "$i" -lt 180 ]; do
    stty rows 40 columns "$((50 + i % 50))" < "$1"
    i=$((i + 1))
  done
  printf '\nRESIZE-BURST-DONE\n' > "$1"
} sh $spawn_out(slave,name) &
await resize-burst-done {RESIZE-BURST-DONE}
settle_output resize-burst
# SIGWINCH events can coalesce during the burst. Require an observed, distinct
# size before restoring; an already-100-column fzf need not repaint at 100.
set observed_output {}
exec stty rows 39 columns 90 < $spawn_out(slave,name)
set distinct_size [string trim [exec stty size < $spawn_out(slave,name)]]
if {$distinct_size ne "39 90"} { puts stderr "PTY failed to set distinct burst dimensions: $distinct_size"; stop_child; exit 1 }
await_layout "$burst_layout_direction,28,*" resize-burst-layout
await resize-burst-distinct-size {PTY body ABC-10 version 1}
settle_output resize-burst-distinct-size
set observed_output {}
exec stty rows 40 columns 100 < $spawn_out(slave,name)
set restored_size [string trim [exec stty size < $spawn_out(slave,name)]]
if {$restored_size ne "40 100"} { puts stderr "PTY failed to restore burst dimensions: $restored_size"; stop_child; exit 1 }
await_layout "$burst_layout_direction,29,*" resize-burst-layout-restored
await resize-burst-restored {PTY body ABC-10 version 1}
set burst_preview_starts_after [llength [split [string trim [slurp $env(PTY_PREVIEW_LOG)]] "\n"]]
if {$burst_preview_starts_after != $burst_preview_starts} {
  puts stderr "visible divider burst restarted the preview renderer ($burst_preview_starts -> $burst_preview_starts_after)"; stop_child; exit 1
}
if {[string trim [slurp [file join $counts ABC-10]]] ne $sweep_fetch_count} {
  puts stderr "resize sweep or burst fetched issue detail again"; stop_child; exit 1
}
puts "ok - narrow/short pane recovery and continuous divider resize"
settle_output before-filter
set navigation_started [clock milliseconds]
send_key "\033\[B\033\[B\033\[B\033\[A\033\[A'ABC-11"
await_selected_key ABC-11
puts "measurement - navigation/filter burst saved final selection in [expr {[clock milliseconds] - $navigation_started}] ms"
await filtered-preview {PTY body ABC-11 version 1}
# Expand to three matches, then verify that another step at either edge stays
# on the same issue regardless of how loaded metadata affects result ranking.
send_key "\177"
settle_output short-filter
set boundary_keys {}
foreach direction {"\033\[A" "\033\[B"} {
  send_key "$direction$direction$direction"
  settle_output filtered-boundary
  set boundary_key [string trim [slurp [file join $state sources source-source-terminal key]]]
  lappend boundary_keys $boundary_key
  send_key $direction
  settle_output past-filtered-boundary
  await_selected_key $boundary_key
}
if {[lindex $boundary_keys 0] eq [lindex $boundary_keys 1]} { puts stderr "filtered navigation did not reach distinct boundaries"; stop_child; exit 1 }
send_key "1"
settle_output restore-single-result
await_selected_key ABC-11
puts "ok - $picker_layout short filtered list stops at both ends"
# Clear at the end, beginning, and middle; then replace immediately. A partial
# clear leaves text behind and cannot match the next exact fictional issue key.
foreach cursor {"" "\001" "\001\033\[C\033\[C"} replacement {ABC-2 ABC-3 ABC-11} {
  send_key "${cursor}\025'$replacement"
  await_selected_key $replacement
  settle_output replace-filter
}
# Clearing twice must keep the picker open and ready for a new query.
send_key "\025\025'ABC-2"
await_selected_key ABC-2
settle_output clear-empty-filter
send_key "\025'ABC-11"
await_selected_key ABC-11
settle_output restore-filter-after-clear
puts "ok - $picker_layout Ctrl-U clears at every cursor position and keeps empty picker open"
set feedback_base_layout [slurp [file join $viewer_dir ui-layout]]
send_key "\031"
await copied-key {Copied key}
send_key "\014"
await copied-link {Copied link}
send_key "\017"
await opened-browser {Opened browser}
await_feedback_clear browser-success
if {[slurp [file join $viewer_dir ui-layout]] ne $feedback_base_layout} { puts stderr "feedback expiry did not restore preview space"; stop_child; exit 1 }
set f [open $action_failure w]; close $f
send_key "\031"
await copy-key-failure {Could not copy key}
send_key "\014"
await copy-link-failure {Could not copy link}
send_key "\017"
await browser-failure {Could not open browser}
await_feedback_clear browser-failure
puts "ok - action success and failure expire without input and restore preview space"
file delete -force $action_failure
send_key "\033OP"
await active-help {PgUp/PgDn scroll preview}
set viewer_dir [lindex [glob -nocomplain -directory $state .viewer.*] 0]
await_help_state 1 filtered-help-open
send_key "\033OP"
await active-help-closed {PTY body ABC-11 version 1}
await_help_state 0 filtered-help-closed
set f [open [file join $source visible] w]; puts $f "ABC-12 ABC-11 ABC-13"; close $f
set f [open [file join $source recent-unwrapped] w]; puts $f ""; close $f
send_key "\r"
await reader {Issue details}
await reader-help {q back · ↑↓ scroll · Space/b page}
send_key "q"
await returned-list {Filter >}
set f [open [file join $source scan-gate] w]; close $f
send_key "\007"
await rescan-start-feedback {Rescanning source pane...}
# Progress must be painted while the source read is still blocked.
if {[file exists [file join $source scan-release]]} { puts stderr "scan was released before feedback"; stop_child; exit 1 }
send_key "\033OP"
await rescan-responsive-help {PgUp/PgDn scroll preview}
send_key "\033OP"
# Resizing used to replace the scan's bg-transform, cancel its process, and
# leave Ctrl-G unbound. The scan must survive and still complete exactly once.
exec stty rows 35 columns 90 < $spawn_out(slave,name)
settle_output rescan-resize-while-gated
exec stty rows 40 columns 100 < $spawn_out(slave,name)
settle_output rescan-resize-restored
send_key "\007\007\007"
settle_output repeated-rescan-while-gated
if {![file exists [file join $viewer_dir rescan-busy]]} { puts stderr "rescan lost busy state during resize"; stop_child; exit 1 }
set f [open [file join $source scan-release] w]; close $f
await rescanned-count {Rescanned: 3 issues}
file delete -force [file join $source scan-gate]
await rescanned-selection {PTY body ABC-11 version 1}
await_help_state 0 post-rescan-settled
settle_output before-post-rescan-refresh
set scan_log [slurp [file join $tmp herdr.log]]
if {[regexp -all {pane read source-pane --source visible} $scan_log] != 1} { puts stderr "repeated Ctrl-G queued duplicate scans"; stop_child; exit 1 }
puts "ok - rescan survives resize and ignores repeated requests while the source read is gated"
set refresh_selected_before [string trim [slurp [file join $state sources source-source-terminal key]]]
set refresh_layout_log_before [slurp [file join $tmp herdr.log]]
send_key "\022"
await refreshed-preview {PTY body ABC-11 version 2}
settle_output refreshed-preview-settled
if {$refresh_selected_before ne "ABC-11" || [string trim [slurp [file join $state sources source-source-terminal key]]] ne $refresh_selected_before} {
  puts stderr "refresh changed the selected issue"; stop_child; exit 1
}
set refresh_layout_log_after [slurp [file join $tmp herdr.log]]
if {$refresh_layout_log_after ne $refresh_layout_log_before} {
  puts stderr "refresh issued a source pane operation"; stop_child; exit 1
}
puts "ok - explicit refresh updates the selected preview without switching issues or source panes"
set viewer_dirs [glob -nocomplain -directory $state .viewer.*]
if {$viewer_dirs ne ""} {
  set stderr_file [file join [lindex $viewer_dirs 0] fzf-stderr]
  if {[file exists $stderr_file] && [file size $stderr_file] != 0} { puts stderr "fzf stderr retained issue content"; stop_child; exit 1 }
}
settle_output before-viewer-close
send_key "\033"
expect {
  -re "\033\\\[6n" { send -i $spawn_id "\033\[1;1R"; exp_continue }
  eof {}
  timeout { puts stderr "PTY timeout: viewer close"; stop_child; exit 1 }
}
set status [wait -i $spawn_id]
if {[lindex $status 3] != 0} { puts stderr "viewer exited nonzero: $status"; exit 1 }
if {[glob -nocomplain -directory $state .viewer.*] ne ""} { puts stderr "viewer temporary directories remain"; exit 1 }
set f [open [file join $state candidates] w]; puts $f "ABC-1"; close $f
set gate [file join $tmp metadata-gate]; set release [file join $tmp metadata-release]; set started [file join $tmp metadata-started]
file delete -force $release $started
set env(PTY_METADATA_GATE) $gate
set env(PTY_METADATA_RELEASE) $release
set env(PTY_METADATA_STARTED) $started
set env(HERDR_VIEWER_CANDIDATES) "ABC-1"
set mf [open $env(PTY_METADATA_LOG) w]; close $mf
set f [open [file join $source visible] w]; puts $f "ABC-1"; close $f
set f [open [file join $source recent-unwrapped] w]; puts $f ""; close $f
spawn -noecho sh "$root/scripts/viewer.sh"
await gated-header {Filter >}
set waited 0
while {![file exists $started] && $waited < 100} { after 50; incr waited }
if {![file exists $started]} { puts stderr "metadata gate did not engage"; stop_child; exit 1 }
send_key "\022"
set f [open [file join $source visible] w]; puts $f "ABC-12 ABC-13"; close $f
send_key "\007"
await queued-rescan {Rescanned: 2 issues}
set f [open [file join $source visible] w]; puts $f "ABC-14 ABC-15 ABC-16"; close $f
send_key "\007"
await latest-rescan {Rescanned: 3 issues}
set observed_output {}
set f [open $release w]; close $f
await released-latest {PTY body ABC-16 version 1}
settle_output before-latest-filter
send_key "'ABC-14"
await selected-latest {PTY body ABC-14 version 1}
await_help_state 0 selected-latest-settled
settle_output before-gated-refresh-close
send_key "\022"
await gated-refresh {PTY body ABC-14 version 2}
settle_output before-gated-viewer-close
send_key "\033"
expect {
  -re "\033\\\[6n" { send -i $spawn_id "\033\[1;1R"; exp_continue }
  eof {}
  timeout { puts stderr "PTY timeout: gated viewer close"; stop_child; exit 1 }
}
set gated_status [wait -i $spawn_id]
if {[lindex $gated_status 3] != 0} { puts stderr "gated viewer exited nonzero: $gated_status"; exit 1 }
if {[glob -nocomplain -directory $state .viewer.*] ne ""} { puts stderr "gated viewer temporary directories remain"; exit 1 }
if {[file exists [file join $counts .metadata-lock]]} { puts stderr "metadata lock remains"; exit 1 }
if {[file exists [file join $tmp metadata-overlap]]} { puts stderr "metadata batches overlapped"; exit 1 }
set log_data [slurp [file join $tmp herdr.log]]
if {[string match "*plugin pane open*" $log_data] || [string match "*plugin pane close*" $log_data]} { puts stderr "rescan changed layout"; exit 1 }
set metadata_data [slurp $env(PTY_METADATA_LOG)]
set metadata_fields {}
foreach line [split $metadata_data "\n"] {
  set words [split [string trim $line]]
  if {[lsearch -exact $words --fields] >= 0} { lappend metadata_fields $words }
}
set requested_keys {}
foreach words $metadata_fields { foreach word $words { if {[regexp {^(ABC-[0-9]+)$} $word -> key]} { lappend requested_keys $key } } }
foreach key {ABC-1 ABC-14 ABC-15 ABC-16} { if {[lsearch -exact $requested_keys $key] < 0} { puts stderr "expected metadata request missing: $key"; exit 1 } }
foreach key {ABC-12 ABC-13} { if {[lsearch -exact $requested_keys $key] >= 0} { puts stderr "intermediate metadata snapshot was fetched: $key"; exit 1 } }
set abc1_count 0
foreach words $metadata_fields { if {[lsearch -exact $words ABC-1] >= 0} { incr abc1_count } }
if {$abc1_count < 2} { puts stderr "queued ABC-1 refresh was lost"; exit 1 }
if {![string match "*pane read source-pane*" $log_data]} { puts stderr "rescan did not read source pane"; exit 1 }

# Escape remains usable during a slow background scan and leaves no viewer state.
unset env(PTY_METADATA_GATE)
file delete -force [file join $source scan-release] [file join $source scan-started]
set f [open [file join $source scan-gate] w]; close $f
spawn -noecho sh "$root/scripts/viewer.sh"
await close-during-scan-picker {Filter >}
await close-during-scan-ready {PTY body ABC-1 version}
settle_output before-close-during-scan
send_key "\007"
await close-during-scan-feedback {Rescanning source pane...}
exec stty rows 10 columns 30 < $spawn_out(slave,name)
settle_output close-during-scan-small-pane
send_key "\033"
expect {
  -re "\033\\\[6n" { send -i $spawn_id "\033\[1;1R"; exp_continue }
  eof {}
  timeout { puts stderr "PTY timeout: close during rescan"; stop_child; exit 1 }
}
set scan_close_status [wait -i $spawn_id]
if {[lindex $scan_close_status 3] != 0} { puts stderr "close during rescan exited nonzero: $scan_close_status"; exit 1 }
if {[glob -nocomplain -directory $state .viewer.*] ne ""} { puts stderr "rescan viewer directories remain"; exit 1 }
file delete -force [file join $source scan-gate]
puts "ok - immediate rescan feedback, responsive help, and Escape in a small pane during a slow scan"
puts "ok - $picker_layout real PTY rescan/filter/reader/refresh/coalescing/close"
