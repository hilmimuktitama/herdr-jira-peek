@@ -0,0 +1,159 @@
+//! Ephemeral text decorations. These never alter terminal contents or input.
+use crate::terminal::TerminalId;
+use ratatui::{
+    buffer::Buffer,
+    layout::Rect,
+    style::{Color, Modifier},
+};
+use std::{
+    collections::HashMap,
+    time::{Duration, Instant},
+};
+
+pub(crate) struct Lease {
+    pub owner: String,
+    pub query: String,
+    pub expires: Instant,
+}
+#[derive(Default)]
+pub(crate) struct Runtime {
+    pub leases: HashMap<TerminalId, Lease>,
+    pub revision: u64,
+}
+impl Runtime {
+    pub fn query(&self, id: &TerminalId) -> Option<&str> {
+        self.leases
+            .get(id)
+            .filter(|lease| lease.expires > Instant::now())
+            .map(|lease| lease.query.as_str())
+    }
+    pub fn expire(&mut self, now: Instant) -> bool {
+        let before = self.leases.len();
+        self.leases.retain(|_, lease| lease.expires > now);
+        self.leases.len() != before
+    }
+}
+pub(crate) const LEASE_DURATION: Duration = Duration::from_millis(1500);
+
+/// Match the rendered cell symbols, with real soft-wrap boundaries. Mapping bytes
+/// back to cells keeps wide glyphs and combining sequences from shifting markers.
+/// The terminal lock is held by the caller, so wrap metadata and cells agree.
+pub(crate) fn decorate(buf: &mut Buffer, area: Rect, wraps: &[bool], query: &str) {
+    if query.is_empty() {
+        return;
+    }
+    let mut text = String::new();
+    let mut positions = Vec::new();
+    for y in 0..area.height {
+        for x in 0..area.width {
+            let symbol = buf[(area.x + x, area.y + y)].symbol();
+            text.push_str(symbol);
+            positions.extend(std::iter::repeat_n((area.x + x, area.y + y), symbol.len()));
+        }
+        if !wraps.get(usize::from(y)).copied().unwrap_or(false) {
+            text.push('\n');
+            positions.push((u16::MAX, u16::MAX));
+        }
+    }
+    let word = |b: u8| b.is_ascii_alphanumeric() || b == b'_' || b == b'-';
+    for (start, _) in text.match_indices(query) {
+        let end = start + query.len();
+        if start
+            .checked_sub(1)
+            .is_some_and(|i| word(text.as_bytes()[i]))
+            || text.as_bytes().get(end).copied().is_some_and(word)
+        {
+            continue;
+        }
+        for &(x, y) in &positions[start..end] {
+            if let Some(cell) = buf.cell_mut((x, y)) {
+                cell.set_fg(Color::Rgb(24, 20, 12));
+                cell.set_bg(Color::Rgb(255, 191, 53));
+                cell.modifier.remove(Modifier::REVERSED | Modifier::DIM);
+                cell.modifier.insert(Modifier::BOLD);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ratatui::style::Style;
+    fn buffer(text: &[&str], width: u16) -> Buffer {
+        let mut buf = Buffer::empty(Rect::new(0, 0, width, text.len() as u16));
+        for (y, line) in text.iter().enumerate() {
+            buf.set_string(
+                0,
+                y as u16,
+                line,
+                Style::default()
+                    .fg(Color::Cyan)
+                    .add_modifier(Modifier::UNDERLINED),
+            );
+        }
+        buf
+    }
+    fn marked(buf: &Buffer) -> usize {
+        buf.content
+            .iter()
+            .filter(|c| c.bg == Color::Rgb(255, 191, 53))
+            .count()
+    }
+    #[test]
+    fn native_highlight_exact_tokens_preserve_symbols_and_links_style() {
+        let mut buf = buffer(&["DEMO-42 DEMO-420 XDEMO-42 DEMO-42x (DEMO-42)"], 60);
+        let original: Vec<_> = buf.content.iter().map(|c| c.symbol().to_owned()).collect();
+        let area = buf.area;
+        decorate(&mut buf, area, &[false], "DEMO-42");
+        assert_eq!(marked(&buf), 14);
+        assert_eq!(
+            original,
+            buf.content
+                .iter()
+                .map(|c| c.symbol().to_owned())
+                .collect::<Vec<_>>()
+        );
+        assert!(buf[(0, 0)].modifier.contains(Modifier::UNDERLINED));
+    }
+    #[test]
+    fn native_highlight_unicode_cells_do_not_shift_matches() {
+        let mut buf = buffer(&["界 e\u{301} DEMO-42"], 30);
+        let area = buf.area;
+        decorate(&mut buf, area, &[false], "DEMO-42");
+        assert_eq!(marked(&buf), 7);
+        assert_eq!(buf[(5, 0)].symbol(), "D");
+        assert_eq!(buf[(5, 0)].bg, Color::Rgb(255, 191, 53));
+    }
+    #[test]
+    fn native_highlight_soft_wraps_only_and_boundary_across_wrap() {
+        let mut soft = buffer(&["xx DEMO-", "42      "], 8);
+        let area = soft.area;
+        decorate(&mut soft, area, &[true, false], "DEMO-42");
+        assert_eq!(marked(&soft), 7);
+        let mut hard = buffer(&["xx DEMO-", "42      "], 8);
+        decorate(&mut hard, area, &[false, false], "DEMO-42");
+        assert_eq!(marked(&hard), 0);
+        let mut longer = buffer(&["xx DEMO-", "420     "], 8);
+        decorate(&mut longer, area, &[true, false], "DEMO-42");
+        assert_eq!(marked(&longer), 0);
+    }
+    #[test]
+    fn native_highlight_lease_expires_without_output() {
+        let mut runtime = Runtime::default();
+        let id = TerminalId::alloc();
+        let now = Instant::now();
+        runtime.leases.insert(
+            id.clone(),
+            Lease {
+                owner: "test-owner".into(),
+                query: "DEMO-42".into(),
+                expires: now + LEASE_DURATION,
+            },
+        );
+        assert_eq!(runtime.query(&id), Some("DEMO-42"));
+        assert!(!runtime.expire(now));
+        assert!(runtime.expire(now + LEASE_DURATION));
+        assert_eq!(runtime.query(&id), None);
+    }
+}
