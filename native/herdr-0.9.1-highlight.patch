+#[test]
+fn native_highlight_real_terminal_wrap_and_alternate_screen_preserve_text() {
+    let mut harness = Harness::new(12, 4);
+    for prefix in ["", "\x1b[?1049h"] {
+        harness.write(format!("{prefix}\x1b[2J\x1b[H界 DEMO-1042 DEMO-10420").as_bytes());
+        let original = harness.pane.visible_text();
+        let mut terminal =
+            ratatui::Terminal::new(ratatui::backend::TestBackend::new(12, 4)).unwrap();
+        terminal
+            .draw(|frame| {
+                harness
+                    .pane
+                    .render_highlighted(frame, frame.area(), false, Some("DEMO-1042"))
+            })
+            .unwrap();
+        let marked = terminal
+            .backend()
+            .buffer()
+            .content
+            .iter()
+            .filter(|cell| cell.bg == Color::Rgb(255, 191, 53))
+            .count();
+        assert_eq!(marked, 9);
+        assert_eq!(harness.pane.visible_text(), original);
+        terminal
+            .draw(|frame| harness.pane.render(frame, frame.area(), false))
+            .unwrap();
+        assert!(!terminal
+            .backend()
+            .buffer()
+            .content
+            .iter()
+            .any(|cell| cell.bg == Color::Rgb(255, 191, 53)));
+    }
+}
+
+#[test]
+#[ignore = "manual native highlight render scaling profile"]
+fn native_highlight_render_scale_profile() {
+    for count in [1, 15] {
+        let mut panes = (0..count).map(|_| Harness::new(80, 24)).collect::<Vec<_>>();
+        for pane in &mut panes {
+            for _ in 0..30 {
+                pane.write("界 DEMO-1042 fictional populated row DEMO-10420\r\n".as_bytes());
+            }
+        }
+        for highlight in [false, true] {
+            let mut term =
+                ratatui::Terminal::new(ratatui::backend::TestBackend::new(80, 24)).unwrap();
+            let start = std::time::Instant::now();
+            for _ in 0..100 {
+                for pane in &panes {
+                    term.draw(|frame| {
+                        pane.pane.render_highlighted(
+                            frame,
+                            frame.area(),
+                            false,
+                            highlight.then_some("DEMO-1042"),
+                        )
+                    })
+                    .unwrap();
+                }
+            }
+            eprintln!(
+                "native highlight panes={count} enabled={highlight}: {:.2} us/frame",
+                start.elapsed().as_secs_f64() * 1_000_000.0 / 100.0
+            );
+        }
+    }
+}
