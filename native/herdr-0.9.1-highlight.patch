new file mode 100644
index 0000000..f283b83
--- /dev/null
+++ b/src/app/api/pane_highlight.rs
@@ -0,0 +1,86 @@
+use super::responses::{encode_error, encode_success};
+use crate::{
+    api::schema::{PaneHighlightClearParams, PaneHighlightSetParams, ResponseResult},
+    app::{
+        pane_highlight::{Lease, LEASE_DURATION},
+        App,
+    },
+};
+impl App {
+    pub(super) fn handle_pane_highlight_set(
+        &mut self,
+        id: String,
+        params: PaneHighlightSetParams,
+    ) -> String {
+        let Some((ws, pane)) = self.parse_pane_id(&params.pane_id) else {
+            return encode_error(id, "pane_not_found", "source pane unavailable");
+        };
+        let Some(terminal) = self
+            .state
+            .terminal_id_for_pane(ws, pane)
+            .filter(|t| t.as_str() == params.terminal_id)
+        else {
+            return encode_error(id, "terminal_mismatch", "source terminal changed");
+        };
+        if params.owner.is_empty()
+            || params.owner.len() > 96
+            || params.query.is_empty()
+            || params.query.len() > 128
+            || !params
+                .query
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+        {
+            return encode_error(
+                id,
+                "invalid_highlight",
+                "expected a bounded literal ASCII token and owner",
+            );
+        }
+        let now = std::time::Instant::now();
+        if self
+            .pane_highlights
+            .leases
+            .get(&terminal)
+            .is_some_and(|l| l.expires > now && l.owner != params.owner)
+        {
+            return encode_error(id, "highlight_busy", "source already has a highlight owner");
+        }
+        if !self.pane_highlights.leases.contains_key(&terminal)
+            && self.pane_highlights.leases.len() >= 64
+        {
+            return encode_error(id, "highlight_limit", "too many highlighted terminals");
+        }
+        if self
+            .pane_highlights
+            .leases
+            .get(&terminal)
+            .is_none_or(|l| l.expires <= now || l.query != params.query)
+        {
+            self.pane_highlights.revision = self.pane_highlights.revision.wrapping_add(1);
+        }
+        self.pane_highlights.leases.insert(
+            terminal,
+            Lease {
+                owner: params.owner,
+                query: params.query,
+                expires: now + LEASE_DURATION,
+            },
+        );
+        encode_success(id, ResponseResult::Ok {})
+    }
+    pub(super) fn handle_pane_highlight_clear(
+        &mut self,
+        id: String,
+        params: PaneHighlightClearParams,
+    ) -> String {
+        let before = self.pane_highlights.leases.len();
+        self.pane_highlights.leases.retain(|terminal, lease| {
+            terminal.as_str() != params.terminal_id || lease.owner != params.owner
+        });
+        if self.pane_highlights.leases.len() != before {
+            self.pane_highlights.revision = self.pane_highlights.revision.wrapping_add(1);
+        }
+        encode_success(id, ResponseResult::Ok {})
+    }
+}
